xt"},{"text":"resize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@S@CGSize","text":"CGSize","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"dimension","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","text":"CGFloat","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"keepAspectRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" = true, ","kind":"text"},{"text":"opaque","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" = false) -> ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UIImage","text":"UIImage","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A new image that is resized according to the given parameters."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function offers flexible resizing options for the UIImage. You can either specify a target size or a dimension (width or height), and choose whether to preserve the image’s original aspect ratio. Additionally, you can specify whether the resulting image should be opaque, which can affect rendering performance."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"size: An optional "},{"type":"codeVoice","code":"CGSize"},{"type":"text","text":" to specify the new size of the image. If "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" parameter is considered. If both "},{"type":"codeVoice","code":"size"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" are "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the original image is returned."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"dimension: An optional "},{"type":"codeVoice","code":"CGFloat"},{"type":"text","text":" that specifies a single dimension (width or height) of the image. The unspecified dimension is automatically calculated to preserve the aspect ratio, unless "},{"type":"codeVoice","code":"keepAspectRatio"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":". If both "},{"type":"codeVoice","code":"size"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" are provided, "},{"type":"codeVoice","code":"size"},{"type":"text","text":" takes precedence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"keepAspectRatio: A Boolean value that determines whether the image’s original aspect ratio should be preserved. Default is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". If "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the image will be resized to the specified "},{"type":"codeVoice","code":"size"},{"type":"text","text":" or "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" without preserving the aspect ratio."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"opaque: A Boolean value that indicates whether the image is opaque. If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the alpha channel is ignored and the image may render more quickly. Default is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]}]},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keepAspectRatio"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is specified, the image will be resized to exactly fit the specified "},{"type":"codeVoice","code":"size"},{"type":"text","text":", potentially distorting the image if its aspect ratio is different from the aspect ratio of "},{"type":"codeVoice","code":"size"},{"type":"text","text":"."}]}],"type":"aside"},{"type":"unorderedList","items":[{"content":[]}]}]}],"hierarchy":{"paths":[["doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials","doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials\/UIKit","doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials\/UIKit\/UIImage"]]},"references":{"doc://ro.randusoft.RSEssentials/documentation/RSEssentials/UIKit":{"kind":"symbol","title":"UIKit","role":"collection","abstract":[],"identifier":"doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials\/UIKit","url":"\/documentation\/rsessentials\/uikit","type":"topic"},"doc://ro.randusoft.RSEssentials/documentation/RSEssentials/UIKit/UIImage":{"abstract":[],"navigatorTitle":[{"text":"UIImage","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials\/UIKit\/UIImage","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"UIImage","preciseIdentifier":"c:objc(cs)UIImage"}],"title":"UIImage","type":"topic","url":"\/documentation\/rsessentials\/uikit\/uiimage","kind":"symbol"},"doc://ro.randusoft.RSEssentials/documentation/RSEssentials":{"title":"RSEssentials","type":"topic","abstract":[],"role":"collection","identifier":"doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials","kind":"symbol","url":"\/documentation\/rsessentials"},"doc://ro.randusoft.RSEssentials/documentation/RSEssentials/UIKit/UIImage/resize(size:dimension:keepAspectRatio:opaque:)":{"kind"