:[{"inlineContent":[{"text":"size: An optional ","type":"text"},{"type":"codeVoice","code":"CGSize"},{"text":" to specify the new size of the image. If ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", the ","type":"text"},{"type":"codeVoice","code":"dimension"},{"text":" parameter is considered. If both ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" and ","type":"text"},{"code":"dimension","type":"codeVoice"},{"text":" are ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the original image is returned.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"dimension: An optional "},{"code":"CGFloat","type":"codeVoice"},{"text":" that specifies a single dimension (width or height) of the image. The unspecified dimension is automatically calculated to preserve the aspect ratio, unless ","type":"text"},{"code":"keepAspectRatio","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":". If both ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"dimension","type":"codeVoice"},{"text":" are provided, ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" takes precedence.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"keepAspectRatio: A Boolean value that determines whether the image’s original aspect ratio should be preserved. Default is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". If "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the image will be resized to the specified "},{"type":"codeVoice","code":"size"},{"type":"text","text":" or "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" without preserving the aspect ratio."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"opaque: A Boolean value that indicates whether the image is opaque. If ","type":"text"},{"code":"true","type":"co