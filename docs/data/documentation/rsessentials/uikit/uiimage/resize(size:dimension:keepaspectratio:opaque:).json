ind":"keyword"},{"text":" ","kind":"text"},{"text":"resize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CGSize","kind":"typeIdentifier","preciseIdentifier":"c:@S@CGSize"},{"text":"? = nil, ","kind":"text"},{"text":"dimension","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":"? = nil, ","kind":"text"},{"text":"keepAspectRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = true, ","kind":"text"},{"text":"opaque","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false) -> ","kind":"text"},{"text":"UIImage","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIImage"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A new image that is resized according to the given parameters.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"This function offers flexible resizing options for the UIImage. You can either specify a target size or a dimension (width or height), and choose whether to preserve the image’s original aspect ratio. Additionally, you can specify whether the resulting image should be opaque, which can affect rendering performance.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"size: An optional "},{"code":"CGSize","type":"codeVoice"},{"type":"text","text":" to specify the new size of the image. If "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" parameter is considered. If both "},{"type":"codeVoice","code":"size"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" are "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the original image is returned."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"dimension: An optional "},{"code":"CGFloat","type":"codeVoice"},{"type":"text","text":" that specifies a single dimension (width or height) of the image. The unspecified dimension is automatically calculated to preserve the aspect ratio, unless "},{"code":"keepAspectRatio","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":". If both "},{"code":"size","type":"codeVoice"},{"type":"text","text":" and "},{"code":"dimension","type":"codeVoice"},{"type":"text","text":" are provided, "},{"code":"size","type":"codeVoice"},{"type":"text","text":" takes precedence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"keepAspectRatio: A Boolean value that determines whether the image’s original aspect ratio should be preserved. Default is "},{"code":"true","type":"codeVoice"},{"type":"text","text":". If "},{"code":"false","type":"codeVoice"},{"type":"text","text":", the image will be resized to the specified "},{"code":"size","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"dimension","type":"codeVoice"},{"type":"text","text":" without preserving the aspect ratio."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"opaque: A Boolean value that indicates whether the image is opaque. If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the alpha channel is ignored and the image may render more quickly. Default is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keepAspectRatio"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is specified, the image will be resized to exactly fit the specified "},{"type":"codeVoice","code":"size"},{"type":"text","text":", potentially distorting the image if its aspect ratio is different from the aspect ratio of "},{"type":"codeVoice","code":"size"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"note"},{"items":[{"content":[]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rsessentials\/uikit\/uiimage\/resize(size:dimension:keepaspectratio:opaque:)"]}],"references":{"doc://ro.randusoft.RSEssentials/documentation/RSEssentials/UIKit":{"title":"UIKit","url":"\/documentation\/rsessentials\/uikit","role":"collection","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials\/UIKit"},"doc://ro.randusoft.RSEssentials/documentation/RSEssentials/UIKit/UIImage":{"navigatorTitle":[{"text":"UIImage","kind":"identifier"}],"role":"symbol","title":"UIImage","kind":"symbol","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UIImage","kind":"identifier","preciseIdentifier":"c:objc(cs)UIImage"}],"type":"topic","url":"\/documentation\/rsessentials\/uikit\/uiimage","identifier":"doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials\/UIKit\/UIImage"},"doc://ro.randusoft.RSEssentials/documentation/RSEssentials":{"abstract":[],"type":"topic","identifier":"doc:\/\/ro.randusoft.RSEssentials\/documentation\/RSEssentials","title":"RSEssentials","kind":"symbol","role":"collection","url":"\/documentation\/rsessentials"},"doc://ro.randusoft.RSEssentials/documentation/RSEssentials/UIKit/UIImage/resize(size:dimension:keepAspectRatio:opaque:)":{"abstr