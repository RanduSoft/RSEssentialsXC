ulated to preserve the aspect ratio, unless "},{"code":"keepAspectRatio","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":". If both "},{"code":"size","type":"codeVoice"},{"type":"text","text":" and "},{"code":"dimension","type":"codeVoice"},{"type":"text","text":" are provided, "},{"code":"size","type":"codeVoice"},{"type":"text","text":" takes precedence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"keepAspectRatio: A Boolean value that determines whether the image’s original aspect ratio should be preserved. Default is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". If "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the image will be resized to the specified "},{"type":"codeVoice","code":"size"},{"type":"text","text":" or "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" without preserving the aspect ratio."}]}]},{"content":[{"inlineContent":[{"text":"opaque: A Boolean value that indicates whether the image is opaque. If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the alpha channel is ignored and the image may render more quickly. Default is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"keepAspectRatio","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and "},{"code":"size","type":"codeVoice"},{"type":"text","text":" is specified, the image will be resized to exactly fit the specified "},{"code":"size","type":"codeVoice"},{"type":"text","text":", potentially distorting the image if its aspect ratio is different from the aspect ratio of "},{"code":"size","type":"codeVoice"},{"type":"text","text":"."}]}]},{"items":[{"content":[]}],"type":"un