ragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"opaque: A Boolean value that indicates whether the image is opaque. If "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the alpha channel is ignored and the image may render more quickly. Default is "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"style":"note","content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"keepAspectRatio","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"size"},{"text":" is specified, the image will be resized to exactly fit the specified ","type":"text"},{"code":"size","type":"codeVoice"},{"text":", potentially distorting the image if its aspect ratio is different from the aspect ratio of ","type":"text"},{"code":"size","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"items":[{"content":[]}],"type":"unorderedList"}]}],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:So7UIImageC12RSEssentialsE6resize4size9dimension15keepAspectRatio6opaqueABSo6CGSizeVSg_14CoreFoundation7CGFloatVSgS2btF","modules":[{"relatedModules":["UIKit"],"name":"RSEssentials"}],"extendedModule":"UIKit","title":"resize(size:dimension:keepAspectRatio:opaque:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@S@CGSize","text":"CGSize","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"dimension","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","text":"CGFloat","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"keepAspectRatio","kind":"externalParam"},{"text":": ","kind":"