,{"type":"text","text":" parameter is considered. If both "},{"type":"codeVoice","code":"size"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" are "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the original image is returned."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"dimension: An optional "},{"type":"codeVoice","code":"CGFloat"},{"type":"text","text":" that specifies a single dimension (width or height) of the image. The unspecified dimension is automatically calculated to preserve the aspect ratio, unless "},{"type":"codeVoice","code":"keepAspectRatio"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":". If both "},{"type":"codeVoice","code":"size"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" are provided, "},{"type":"codeVoice","code":"size"},{"type":"text","text":" takes precedence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"keepAspectRatio: A Boolean value that determines whether the image’s original aspect ratio should be preserved. Default is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". If "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the image will be resized to the specified "},{"type":"codeVoice","code":"size"},{"type":"text","text":" or "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" without preserving the aspect ratio."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"opaque: A Boolean value that indicates whether the image is opaque. If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the alpha channel is ignored and the image may render more quickly. Default is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"c