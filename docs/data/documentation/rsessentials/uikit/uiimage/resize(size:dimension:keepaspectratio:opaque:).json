pect ratio, unless ","type":"text"},{"type":"codeVoice","code":"keepAspectRatio"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"text":". If both ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"dimension"},{"text":" are provided, ","type":"text"},{"type":"codeVoice","code":"size"},{"type":"text","text":" takes precedence."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"keepAspectRatio: A Boolean value that determines whether the image’s original aspect ratio should be preserved. Default is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". If "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the image will be resized to the specified "},{"type":"codeVoice","code":"size"},{"type":"text","text":" or "},{"type":"codeVoice","code":"dimension"},{"type":"text","text":" without preserving the aspect ratio."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"opaque: A Boolean value that indicates whether the image is opaque. If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the alpha channel is ignored and the image may render more quickly. Default is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"keepAspectRatio","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is specified, the image will be resized to exactly fit the specified "},{"code":"size","type":"codeVoice"},{"type":"text","text":", potentially distorting the image if its aspect ratio is different from the aspect ratio of "},{"type":"codeVoice","code":"size"},{"type":"text","text":"."}]}],"style":"note","type":"aside","name":"Note"},{"items":[{"content":[]}],"type":"unorderedList